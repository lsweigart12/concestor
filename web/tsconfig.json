{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  // `worker/` is not part of the bundle — vite never sees it, wrangler builds
  // it separately — but it is typechecked here rather than in a second
  // tsconfig, because it is small, it uses only Request/Response, and a
  // deploy-path file nobody typechecks is exactly the file that breaks on the
  // first deploy.
  "include": ["src", "worker", "vite.config.ts", "vitest.config.ts"]
}
