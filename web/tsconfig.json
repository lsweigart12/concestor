{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  // `worker/` is typechecked by tsconfig.worker.json, not here. It needs the
  // Workers runtime types and this project needs the DOM's, and the two
  // conflict. Both run under `npm run typecheck` and `npm run build`.
  "include": ["src", "vite.config.ts", "vitest.config.ts"]
}
