.codex/

# One checkout per parallel Claude Code session. They are real worktrees of
# this repository, not content of it.
/.claude/worktrees/

# Immutable upstream snapshot (~500 MB) and derived artifacts. Reproduced by
# `concestor-build snapshot`; provenance lives in snapshot/manifest.json, which
# IS tracked.
/snapshot/*
!/snapshot/manifest.json
#
# `/build`, not `/build/*`: in a worktree the artifacts are borrowed, and
# `scripts/check.sh` links them in as a *symlink* named build, which `/build/*`
# does not match. Nothing under build/ has ever been tracked — the old
# `!/build/.gitkeep` exception was protecting a file that does not exist — so
# ignoring the name outright costs nothing and covers both shapes.
/build
#
# The previous build's database, kept beside the new one so the two can be
# diffed. It sits at the root rather than under build/, so `/build` does not
# cover it, and at ~1.8 GB a blanket `git add` puts a commit past GitHub's
# 100 MB file limit — which is only reported by the remote, on push.
/build.prev-*.db

.venv/
__pycache__/
*.pyc
.pytest_cache/

# Frontend
/web/node_modules/
/web/dist/
/web/.vite/

# wrangler's local state and the `--dry-run` bundle. wrangler.jsonc IS tracked.
#
# Unanchored, unlike most rules here, because wrangler is run from the
# repository root as well as from web/ — `docs/deployment.md`'s deploy path is
# a root invocation. That writes `.wrangler/cache/wrangler-account.json`, which
# holds the Cloudflare account id and name. `/web/.wrangler/` matched it
# nowhere, so it sat untracked *and* unignored, one `git add -A` away from
# being published. No secret is in there — wrangler keeps credentials in
# ~/.config/.wrangler — but an account id is not ours to hand out either.
.wrangler/

# Go
/server/concestor-serve
/web/tsconfig.tsbuildinfo
.vscode/*

# Release artifacts, built by scripts/ci/build-release.sh from a tag.
/release-artifacts/
*/.DS_Store
